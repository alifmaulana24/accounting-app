// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Product {
  sku       String   @id @db.VarChar(50)
  name      String   @db.VarChar(255)
  category  String   @db.VarChar(100)
  brand     String?  @db.VarChar(100)
  unit      String   @db.VarChar(30)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("products")
}


model Supplier {
  supplierCode String   @id @map("supplier_code") @db.VarChar(50)
  name         String   @db.VarChar(255)
  phone        String?  @db.VarChar(30)
  email        String?  @db.VarChar(255)
  address      String?  @db.Text

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([name])
  @@map("suppliers")
}


model Customer {
  customerCode String   @id @map("customer_code") @db.VarChar(50)
  name         String   @db.VarChar(255)
  phone        String?  @db.VarChar(30)
  email        String?  @db.VarChar(255)
  address      String?  @db.Text

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([name])
  @@map("customers")
}

model Purchase {
  id             String   @id @default(uuid()) @db.Uuid
  purchaseNumber String   @unique @map("purchase_number") @db.VarChar(30)
  purchaseDate   DateTime @map("purchase_date") @db.Date

  supplierCode String @map("supplier_code") @db.VarChar(50)
  supplierName String @map("supplier_name") @db.VarChar(255)

  totalAmount Decimal @map("total_amount") @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items    PurchaseItem[]
  payments PurchasePayment[]

  @@index([purchaseDate])
  @@index([supplierCode])
  @@map("purchases")
}

model PurchaseItem {
  id         String @id @default(uuid()) @db.Uuid
  purchaseId String @map("purchase_id") @db.Uuid

  productSku  String @map("product_sku") @db.VarChar(50)
  productName String @map("product_name") @db.VarChar(255)
  unit        String @db.VarChar(30)

  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(18, 2)
  subtotal   Decimal @db.Decimal(18, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@unique([purchaseId, productSku])
  @@map("purchase_items")
}

model PurchasePayment {
  id         String @id @default(uuid()) @db.Uuid
  purchaseId String @map("purchase_id") @db.Uuid

  paymentDate DateTime @map("payment_date") @db.Date
  amount      Decimal  @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@map("purchase_payments")
}



model Sale {
  id         String   @id @default(uuid()) @db.Uuid
  saleNumber String   @unique @map("sale_number") @db.VarChar(30)
  saleDate   DateTime @map("sale_date") @db.Date

  customerCode String @map("customer_code") @db.VarChar(50)
  customerName String @map("customer_name") @db.VarChar(255)

  totalAmount Decimal @map("total_amount") @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items    SaleItem[]
  payments SalePayment[]

  @@index([saleDate])
  @@index([customerCode])
  @@map("sales")
}

model SaleItem {
  id     String @id @default(uuid()) @db.Uuid
  saleId String @map("sale_id") @db.Uuid

  productSku  String @map("product_sku") @db.VarChar(50)
  productName String @map("product_name") @db.VarChar(255)
  unit        String @db.VarChar(30)

  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(18, 2)
  subtotal  Decimal @db.Decimal(18, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([saleId, productSku])
  @@map("sale_items")
}

model SalePayment {
  id     String @id @default(uuid()) @db.Uuid
  saleId String @map("sale_id") @db.Uuid

  paymentDate DateTime @map("payment_date") @db.Date
  amount      Decimal  @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_payments")
}
